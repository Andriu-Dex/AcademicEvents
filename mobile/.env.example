# API del backend para la app móvil.
# Recomendado: 'auto' en desarrollo para autodetectar host por Metro/Expo.
EXPO_PUBLIC_API_URL=auto

# Tenant por defecto (debe existir en BD; normalmente 'uta').
EXPO_PUBLIC_TENANT_SLUG=uta

# Alternativas para EXPO_PUBLIC_API_URL:
# - Emulador Android: http://10.0.2.2:3000
# - iOS simulator: http://localhost:3000
