generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// MODELOS PRINCIPALES
// ============================

model usuario {
  id_usu        String        @id @default(uuid()) // UUID como ID del usuario
  ced_usu       String        @unique // Cédula única del usuario
  nom_usu       String        // Nombre del usuario
  ape_usu       String        // Apellido del usuario
  cel_usu       String        @db.Char(10) // Solo 10 caracteres exactos
  fec_cre_usu   DateTime      @default(now()) // Fecha de creación del usuario
  com_usu       String?       // url de la cedula, papeleta de votacion o matricula
  id_car_est    String?       // FK opcional a carrera
  img_per_usu   String?       // URL de la imagen de perfil del usuario en imgur

  carrera       carrera?      @relation(fields: [id_car_est], references: [id_car]) // Relación 1:N (usuario puede estar en una o ningua carrera)
  cuentas       cuenta[]      // Relación 1:N (usuario puede tener muchas cuentas)
}

model comprobante_pago {
  id_com_pag         String           @id @default(uuid()) // UUID como ID del documento
  id_ins_per         String           // FK a inscripción
  url_com_pag        String           // URL del documento
  est_com_pag        estado_validacion @default(PENDIENTE) // Estado del documento (PENDIENTE, ACEPTADO, RECHAZADO)
  fec_sub_com_pag    DateTime         @default(now()) // Fecha de subida del documento
  fec_val_com_pag    DateTime?        // Fecha de validación del documento
  id_adm_val_com_pag String?          // FK opcional a administrador que valida el documento
  fec_pag_ins       DateTime?          // Fecha de pago de la inscripción

  admin          cuenta?         @relation(fields: [id_adm_val_com_pag], references: [id_cue]) // Relación 1:1 (documento puede ser validado por un administrador)
  inscripcion    inscripcion     @relation(fields: [id_ins_per], references: [id_ins]) // Relación 1:N (documento pertenece a una inscripción)
  // observaciones  observacion_comprobante[]   // Relación 1:N (documento puede tener muchas observaciones)
}

model carta_motivacion {
  id_car_mot       String           @id @default(uuid()) // UUID como ID del documento
  id_ins_per       String           // FK a inscripción
  con_car_mot      String           // contenido de la carta de motivación
  est_car_mot      estado_validacion @default(PENDIENTE) // Estado del documento (PENDIENTE, ACEPTADO, RECHAZADO)
  fec_sub_car_mot  DateTime         @default(now()) // Fecha de subida del documento
  fec_val_car_mot  DateTime?        // Fecha de validación del documento
  id_adm_val_car_mot String?        // FK opcional a administrador que valida el documento

  admin          cuenta?         @relation(fields: [id_adm_val_car_mot], references: [id_cue]) // Relación 1:1 (documento puede ser validado por un administrador)
  inscripcion    inscripcion     @relation(fields: [id_ins_per], references: [id_ins]) // Relación 1:N (documento pertenece a una inscripción)
  // observaciones  observacion_motivacion[]   // Relación 1:N (documento puede tener muchas observaciones)
}

