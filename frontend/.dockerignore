# ============================
# DEPENDENCIAS Y CACHE
# ============================
# Excluir node_modules ya que se instalan dentro del contenedor
node_modules
# Logs de npm para debugging local
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Cache de npm y yarn
.npm
.yarn
# Cache de Vite
.vite

# ============================
# VARIABLES DE ENTORNO
# ============================
# Archivos de configuración sensible (se configuran en build time)
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
# .env.production se incluye para el build

# ============================
# ARCHIVOS DE BUILD
# ============================
# Directorio de salida de Vite (se genera dentro del contenedor)
dist
build
# Archivos de build de desarrollo
*.tsbuildinfo

# ============================
# CONTROL DE VERSIONES
# ============================
# Carpeta de Git y archivos relacionados
.git
.gitignore
.gitattributes

# ============================
# DOCUMENTACIÓN Y METADATOS
# ============================
# Archivos de documentación (no necesarios en producción)
README.md
*.md
LICENSE
CHANGELOG.md

# ============================
# ARCHIVOS DE SISTEMA
# ============================
# Archivos de sistema macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
# Archivos de sistema Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================
# HERRAMIENTAS DE DESARROLLO
# ============================
# Configuración de editores
.vscode
.idea
*.swp
*.swo
*~
# Configuración de ESLint, Prettier, etc.
.eslintrc*
.prettierrc*
eslint.config.js
# Configuración de testing
coverage
.nyc_output
# Configuración de Tailwind (se incluye para el build)

# ============================
# ARCHIVOS TEMPORALES Y LOGS
# ============================
# Logs de la aplicación
logs
*.log
# Archivos temporales
temp
tmp

# ============================
# STORYBOOK Y HERRAMIENTAS
# ============================
# Storybook
.storybook
storybook-static
# Otros archivos de herramientas
.parcel-cache
