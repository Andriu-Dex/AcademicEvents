# ============================
# VARIABLES DE ENTORNO - EJEMPLO
# ============================
# Copia este archivo como .env y configura tus valores reales
# Este archivo SÍ puede subirse a Git como referencia

# Base de datos
POSTGRES_DB=academic_events
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-password-segura-aqui

# JWT Secret (genera uno único y seguro)
# Puedes usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genera-un-jwt-secret-super-seguro-de-64-caracteres-minimo

# URLs
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:3000

# URL del backend para el frontend (Vite)
VITE_API_URL=http://localhost:3000

# Configuración de Node
NODE_ENV=production
PORT=3000

# Conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:tu_contraseña@postgres:tu_puerto/nombre_base

# Configuración del servidor
# HOST=localhost (comentado para Docker)
HOST=0.0.0.0

#Dirección del servidor SMTP. Gmail usa smtp.gmail.com
SMTP_HOST=smtp.gmail.com

#Puerto del servidor. El 587 es para conexiones seguras (STARTTLS)
SMTP_PORT=587

#Tu dirección de correo electrónico desde la cual se enviarán los correos
SMTP_USER=tu_correo@gmail.com

#Contraseña de aplicación Gmail
SMTP_PASS=tu_contraseña_de_aplicacion

# Configuración de Imgur
IMGUR_CLIENT_ID=tu_client_id_de_imgur

# Client Secret de Imgur
IMGUR_CLIENT_SECRET=tu_client_secret_de_imgur

#Credenciales de Super Admin
SUPER_ADMIN_EMAIL=admin@uta.edu.ec
SUPER_ADMIN_PASSWORD=Admin12345
SUPER_ADMIN_CEDULA=9999999999

# Configuración para estados automáticos de eventos
# Habilitar/deshabilitar logs del sistema de estados automáticos
EVENT_STATUS_LOGS_ENABLED=false
# Habilitar/deshabilitar el cron para actualizar estados de eventos
EVENT_STATUS_CRON_ENABLED=false
# Cada 5 minutos se ejecutará el cron
EVENT_STATUS_CRON_SCHEDULE="*/5 * * * *"
# Zona horaria para el cron
EVENT_STATUS_TIMEZONE="America/Guayaquil"

# Configuración de logs de Socket.IO
# Habilitar/deshabilitar logs del sistema de sockets
SOCKET_LOGS_ENABLED=true

# Configuración de logs de Verificación de Cupos
# Habilitar/deshabilitar logs del sistema de verificación de cupos
CUPOS_VERIFICATION_LOGS_ENABLED=false

# Configuración de logs de Paginación de Eventos
# Habilitar/deshabilitar logs del sistema de paginación de eventos
EVENT_PAGINATION_LOGS_ENABLED=false

#================================
#FRONTEND CONFIGURATION
#================================

# Configurar para usar el proxy de nginx en lugar de llamar directamente al backend
VITE_API_URL=http://localhost
VITE_HOST=localhost
VITE_PORT=5173

# Configuración de Puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser